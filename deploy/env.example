# Written to deploy/.env by bootstrap.sh from SSM Parameter Store. Never committed.
ENVIRONMENT=production
DOMAIN=demo.example.com
APP_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/docforge-app:<git sha>
WEB_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/docforge-web:<git sha>

POSTGRES_PASSWORD=<generated>
# The owner, for migrations and the demo seed; the application's restricted login.
MIGRATION_DATABASE_URL=postgresql+psycopg://docforge:<POSTGRES_PASSWORD>@postgres:5432/docforge
DATABASE_URL=postgresql+psycopg://docforge_app_user:<generated>@postgres:5432/docforge

# S3 with the instance's role: no endpoint, no keys.
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=<bucket from terraform output>

WEBHOOK_SIGNING_KEY=<generated>
# The demo runs on the recorded synthetic documents: no model key, no model cost.
PIPELINE_FACTORY=docforge.wiring:build_replay_pipelines
GEMINI_API_KEY=
DEMO_PIN=<generated, 6+ digits; shown on the demo's sign-in page>
PARSER_OFFLINE=true
