# bootstrap.sh writes three files from SSM Parameter Store (Terraform generates them).
# Never committed. Shown here together; each block is one file.

# --- .env (/docforge/demo/compose): read by Compose itself -------------------------------
DOMAIN=demo.example.com
APP_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/docforge-app:<git sha>
WEB_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/docforge-web:<git sha>
DEMO_PIN=<6+ digits; shown on the demo's sign-in page, public by design>

# --- app.env (/docforge/demo/app): the API and the worker --------------------------------
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://docforge_app_user:<generated>@postgres:5432/docforge
# The services never hold the owner's password: this is the same restricted login.
MIGRATION_DATABASE_URL=postgresql+psycopg://docforge_app_user:<generated>@postgres:5432/docforge
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=<originals bucket>
# A key that can only read and write that bucket; the containers cannot reach the host role.
AWS_ACCESS_KEY_ID=<generated>
AWS_SECRET_ACCESS_KEY=<generated>
WEBHOOK_SIGNING_KEY=<generated>
# The isolated converter (LibreOffice); bootstrap.sh copies this token into converter.env.
CONVERTER_URL=http://converter:8090
CONVERTER_TOKEN=<generated, 32 characters or more>
PIPELINE_FACTORY=docforge.wiring:build_replay_pipelines
GEMINI_API_KEY=
PARSER_OFFLINE=true
PARSER_MAX_RSS_MB=2048
DEMO_PIN=<same as above>

# --- converter.env: written by bootstrap.sh from app.env, the converter's only setting ---
# CONVERTER_TOKEN=<the same as in app.env>

# --- owner.env (/docforge/demo/owner): Postgres and the one-shot admin service only ------
POSTGRES_PASSWORD=<generated>
MIGRATION_DATABASE_URL=postgresql+psycopg://docforge:<POSTGRES_PASSWORD>@postgres:5432/docforge
