{"parser":"docling","parser_version":"2.132.0","source":"text_layer","pages":[{"number":1,"width":612.0,"height":792.0}],"blocks":[{"id":"b1","kind":"text","text":"SOP-QA-014: Receipt of goods at the warehouse","page":1,"bbox":{"x0":90.1,"y0":679.98,"x1":471.78,"y1":693.64},"table":null,"row":null,"col":null,"header":false},{"id":"b2","kind":"text","text":"Purpose. This procedure says how goods from suppliers are received, counted and quarantined until quality assurance releases them. Scope. It applies to every delivery of active ingredients, excipients and packaging material at the Vadodara warehouse.","page":1,"bbox":{"x0":90.1,"y0":610.56,"x1":485.65,"y1":675.46},"table":null,"row":null,"col":null,"header":false},{"id":"b3","kind":"text","text":"Procedure","page":1,"bbox":{"x0":90.1,"y0":586.22,"x1":165.2,"y1":596.28},"table":null,"row":null,"col":null,"header":false},{"id":"b4","kind":"text","text":"Check the delivery challan and the purchase order number before unloading.","page":1,"bbox":{"x0":90.1,"y0":553.76,"x1":477.39,"y1":579.26},"table":null,"row":null,"col":null,"header":false},{"id":"b5","kind":"text","text":"Count every case and compare the batch numbers with the certificate of analysis.","page":1,"bbox":{"x0":90.1,"y0":524.36,"x1":512.97,"y1":549.86},"table":null,"row":null,"col":null,"header":false},{"id":"b6","kind":"text","text":"Record the temperature of cold-chain goods; anything above 8 °C is rejected.","page":1,"bbox":{"x0":90.1,"y0":494.96,"x1":487.44,"y1":520.46},"table":null,"row":null,"col":null,"header":false},{"id":"b7","kind":"text","text":"Move accepted goods to quarantine with a yellow label until QA releases them.","page":1,"bbox":{"x0":90.1,"y0":467.84,"x1":514.93,"y1":491.06},"table":null,"row":null,"col":null,"header":false},{"id":"b8","kind":"table_cell","text":"Role","page":1,"bbox":{"x0":90.1,"y0":442.64,"x1":114.99,"y1":451.16},"table":0,"row":0,"col":0,"header":false},{"id":"b9","kind":"table_cell","text":"Responsibility","page":1,"bbox":{"x0":234.1,"y0":440.36,"x1":312.54,"y1":451.16},"table":0,"row":0,"col":1,"header":false},{"id":"b10","kind":"table_cell","text":"Record","page":1,"bbox":{"x0":378.1,"y0":442.64,"x1":417.93,"y1":451.16},"table":0,"row":0,"col":2,"header":false},{"id":"b11","kind":"table_cell","text":"Warehouse officer","page":1,"bbox":{"x0":90.1,"y0":429.34,"x1":191.98,"y1":437.86},"table":0,"row":1,"col":0,"header":false},{"id":"b12","kind":"table_cell","text":"Counts and labels goods","page":1,"bbox":{"x0":234.1,"y0":414.26,"x1":333.73,"y1":437.86},"table":0,"row":1,"col":1,"header":false},{"id":"b13","kind":"table_cell","text":"Goods receipt note","page":1,"bbox":{"x0":378.1,"y0":427.21,"x1":483.71,"y1":437.86},"table":0,"row":1,"col":2,"header":false},{"id":"b14","kind":"table_cell","text":"QA officer","page":1,"bbox":{"x0":90.1,"y0":401.64,"x1":146.42,"y1":411.76},"table":0,"row":2,"col":0,"header":false},{"id":"b15","kind":"table_cell","text":"Releases or rejects the batch","page":1,"bbox":{"x0":234.1,"y0":390.44,"x1":361.4,"y1":411.76},"table":0,"row":2,"col":1,"header":false},{"id":"b16","kind":"table_cell","text":"Release certificate","page":1,"bbox":{"x0":378.1,"y0":403.24,"x1":481.85,"y1":411.76},"table":0,"row":2,"col":2,"header":false},{"id":"b17","kind":"text","text":"Retention. Goods receipt notes are kept for five years after the expiry of the batch.","page":1,"bbox":{"x0":90.1,"y0":362.44,"x1":514.88,"y1":385.66},"table":null,"row":null,"col":null,"header":false}]}
