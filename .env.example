# Copy to .env and fill in. .env is gitignored; never commit real keys.

# "local" or "production". Production refuses the default credentials below.
ENVIRONMENT=local

# Local services (defaults match docker-compose.yml; local development only)
POSTGRES_USER=docforge
POSTGRES_PASSWORD=docforge
POSTGRES_DB=docforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://docforge:docforge@127.0.0.1:5432/docforge

MINIO_ROOT_USER=docforge
MINIO_ROOT_PASSWORD=docforge-local-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=docforge
S3_SECRET_KEY=docforge-local-secret
S3_BUCKET=docforge-originals

# Model provider (development: Gemini free tier, synthetic data only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Model prices in USD per million tokens, for cost per document. Gemini 3.5 Flash-Lite paid
# tier, from https://ai.google.dev/gemini-api/docs/pricing (updated 2026-10-01); output
# includes thinking tokens. Check before relying on them.
# PRICE_INPUT_PER_MILLION_USD=0.30
# PRICE_OUTPUT_PER_MILLION_USD=2.50

# Export traces over OTLP/HTTP (e.g. a local Jaeger or an OpenTelemetry collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
